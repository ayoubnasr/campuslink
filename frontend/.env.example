# Copy this file to frontend/.env and fill in the values.
# Base URLs of the backend API routes (read at build time by Create React App).
REACT_APP_AUTHENTICATION_URL=http://localhost:5000/api/auth
REACT_APP_FYP_URL=http://localhost:5000/api/fyp
REACT_APP_USER_URL=http://localhost:5000/api/user
REACT_APP_CABINET_URL=http://localhost:5000/api/cabinet
REACT_APP_DISCOVERY_URL=http://localhost:5000/api/discovery
