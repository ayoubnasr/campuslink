# Copy this file to .env in the project root and fill in the values.
# The backend loads it from here (see dotenv.config calls in backend/src).

# --- Server ---
PORT=5000
# Set to "production" when deployed over HTTPS (makes the login cookie secure-only)
NODE_ENV=development
# Folder for uploaded images; on a host, point this at a persistent volume (e.g. /data). Optional locally.
UPLOADS_DIR=

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=campuslink
DB_PASSWORD=change-me
DB_NAME=campuslinkdatabase

# --- Auth ---
# Long random string used to sign login tokens (JWT)
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the backend's auth routes (used in verification / password reset emails)
AUTHENTICATION_URL=http://localhost:5000/api/auth

# --- CORS: frontend origins allowed to call the API ---
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_DEVELOPMENT=http://localhost:3000

# --- Email (Gmail app password for campuslinkteam@gmail.com) ---
# Optional: if empty, verification and password reset links are printed to the server log instead of emailed.
GMAIL_APP_PASS=

# --- Google Cloud Vision (image moderation, currently disabled in code) ---
# Optional: path to the service-account JSON key, relative to the project root
GOOGLE_VISION_CREDENTIALS_PATH=google-vision-key.json

# --- Neutrino API (bad-word filter) ---
# Optional: if empty or unreachable, the local bad-words filter is used instead.
NEUTRINO_USER_ID=
NEUTRINO_API_KEY=
